# ============================================================
# Copia este archivo a .env y rellena con tus valores reales
# NUNCA subas el archivo .env a GitHub
# ============================================================

# Connection string de Supabase (PostgreSQL)
# La encuentras en: Project Settings → Database → Connection string → URI
# Reemplaza [TU_PASSWORD] por la contraseña real de la base de datos

DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[TU_PROJECT_REF].supabase.co:5432/postgres
